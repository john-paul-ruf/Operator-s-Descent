{
  "name": "operators-descent",
  "version": "0.1.0",
  "private": true,
  "description": "Operator's Descent — deterministic browser roguelike (static files, no build step).",
  "author": "John Ruf / Glitch Forgeworks LLC",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "serve": "node scripts/server.js",
    "start": "node scripts/start.js",
    "stop": "node scripts/stop.js",
    "restart": "node scripts/stop.js && node scripts/start.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "font:build": "python3 ./tools/font/build_font.py",
    "font:check": "python3 ./tools/font/build_font.py --check && python3 ./scripts/verify-font.py",
    "lint:sigils": "node ./scripts/lint-sigils.js",
    "design:scan": "node ./scripts/scan-design-compliance.js",
    "check:assets": "node ./scripts/verify-assets.js",
    "stress:generation": "node ./scripts/stress-generation.js --seeds 250 --depths 1,10,50,100",
    "stress:saves": "node ./scripts/stress-saves.js",
    "simulate": "node ./scripts/simulate-runs.js --runs 50",
    "budget:report": "node ./scripts/report-budget.js",
    "validate": "node ./scripts/validate-data.js && npm run lint:sigils && npm run font:check && npm run check:assets && npm test",
    "check:release": "npm run validate && npm run stress:generation && npm run stress:saves && npm run simulate && npm run budget:report && npm run test:e2e",
    "test:e2e": "playwright test",
    "parity:shots": "node ./scripts/screenshot-parity.js",
    "build:css": "node tools/tailwind/build-css.mjs",
    "build:icons": "node tools/icons/build-sprite.mjs",
    "build:assets": "npm run build:css && npm run build:icons"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "lucide": "^0.400.0",
    "tailwindcss": "^3.4.0",
    "vitest": "^4.1.10"
  }
}
